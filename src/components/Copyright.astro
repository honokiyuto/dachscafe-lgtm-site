---
type Props = {
  name: string;
};

const { name }: Props = Astro.props;
const currentYear: number = new Date().getFullYear();
---

<footer>
  <div class="copyright">
    <p>&copy; {currentYear} {name}. All rights reserved.</p>
  </div>
</footer>

<style>
footer {
  margin-top: 4rem;
  text-align: center;
}

footer p {
  color: var(--muted);
  font-size: 0.75rem;
}
</style>
