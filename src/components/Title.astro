---
import { Icon } from 'astro-icon/components';
type Props = {
  text: string;
};

const { text } = Astro.props;
---

<h1>
  {text}
  <span class="icon"><Icon name="cil:animal" /></span>
</h1>
<p>Click an image to copy Markdown</p>
<style>
  h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 4.5rem;
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-align: center;
  }
  @media (max-width: 768px) {
    h1 {
      font-size: 2.75rem;
    }
  }
  .icon {
    display: inline-block;
    color: var(--accent);
    font-size: 0.5em;
    vertical-align: middle;
  }
  p {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-align: center;
  }
</style>
