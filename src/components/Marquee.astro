---
import RunningDachshund from './RunningDachshund/index.vue';
---

<div class="marquee">
  <div class="marqueeContent">
    <RunningDachshund client:only />
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .marqueeContent {
    transform: translateX(100%);
    animation: marquee 12s linear infinite;
  }

  @media (max-width: 768px) {
    .marqueeContent {
      animation-duration: 8s;
    }
  }

  @keyframes marquee {
    0% {
      transform: translateX(100%);
    }
    100% {
      transform: translateX(-100%);
    }
  }
</style>
